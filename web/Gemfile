source "https://rubygems.org"

gem "rails", "~> 8.1.3"
gem "sqlite3", ">= 2.1"
gem "puma", ">= 5.0"
gem "bcrypt", "~> 3.1"
# json 3.0 changed JSON.parse's signature; ActiveSupport::JSON.decode in Rails 8.1.3 still passes two arguments.
gem "json", "~> 2.10"

gem "tzinfo-data", platforms: %i[ windows jruby ]

# FactoryBot is also loaded in UAT: the seed endpoint builds test data from the same factories as RSpec.
# It is deliberately absent from production, where the endpoint does not exist.
group :development, :test, :uat do
  gem "factory_bot_rails", "~> 6.4"
end

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "rspec-rails", "~> 8.0"
end

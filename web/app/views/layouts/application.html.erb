<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), current_organization&.name, "Hireflow"].compact.join(" · ") %></title>
    <%= render "layouts/head" %>
  </head>
  <body>
    <% if current_user %>
      <div class="shell">
        <aside class="sidebar">
          <%= render "layouts/brand" %>
          <div class="sidebar__tenant">
            <span class="t-eyebrow">Organization</span>
            <span class="sidebar__tenant-name"><%= current_organization.name %></span>
          </div>
          <nav class="nav" aria-label="Main">
            <% if current_user.staff? %>
              <%= nav_item "Dashboard", org_dashboard_path, "home" %>
              <%= nav_item "Templates", org_interview_templates_path, "boxes" %>
              <%= nav_item "Invitations", org_invitations_path, "message" %>
              <%= nav_item "Team", org_team_members_path, "user" if current_user.admin? %>
            <% else %>
              <%= nav_item "My interviews", org_interviews_path, "calendar-clock" %>
            <% end %>
          </nav>
        </aside>
        <div>
          <header class="topbar">
            <span class="user-chip">
              <span class="user-chip__avatar"><span class="icon icon--md icon--user" aria-hidden="true"></span></span>
              <span data-testid="current-user"><span class="user-chip__name"><%= current_user.name %></span> <span class="muted">(<%= current_user.role %>)</span></span>
            </span>
            <%= button_to "Sign out", org_logout_path, method: :delete, class: "btn btn--surface btn--sm", form_class: "button-form" %>
          </header>
          <main class="page">
            <%= render "layouts/flash" %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="centered">
        <div class="stack" style="align-items: center">
          <%= render "layouts/brand" %>
          <div class="card"><%= yield %></div>
        </div>
      </main>
    <% end %>
  </body>
</html>

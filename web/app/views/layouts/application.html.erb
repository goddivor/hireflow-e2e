<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), current_organization&.name, "Hireflow"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <style>
      :root { --line: #e3e3e8; --muted: #666; --accent: #3446d4; }
      * { box-sizing: border-box; }
      body { font: 15px/1.5 system-ui, sans-serif; margin: 0; color: #1c1c21; }
      header { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; padding: .75rem 1.25rem; border-bottom: 1px solid var(--line); }
      header nav { display: flex; gap: 1rem; align-items: center; }
      main { max-width: 60rem; margin: 1.5rem auto; padding: 0 1.25rem; }
      a { color: var(--accent); }
      form.stack { display: grid; gap: .75rem; max-width: 26rem; }
      label { display: grid; gap: .25rem; font-weight: 500; }
      input, select, textarea { font: inherit; padding: .45rem .55rem; border: 1px solid #c9c9d1; border-radius: 6px; }
      button, .button { font: inherit; padding: .45rem .9rem; border-radius: 6px; border: 1px solid var(--accent); background: var(--accent); color: #fff; cursor: pointer; text-decoration: none; }
      button.secondary { background: #fff; color: var(--accent); }
      button:disabled { opacity: .5; cursor: not-allowed; }
      [role=alert] { padding: .6rem .8rem; border-radius: 6px; background: #fdecea; color: #8a1c10; }
      [role=status].flash { padding: .6rem .8rem; border-radius: 6px; background: #e8f5e9; color: #1b5e20; }
      table { width: 100%; border-collapse: collapse; }
      th, td { text-align: left; padding: .5rem; border-bottom: 1px solid var(--line); }
      .toolbar { display: flex; flex-wrap: wrap; gap: .75rem; align-items: end; margin-bottom: 1rem; }
      .question-row { display: flex; gap: .5rem; align-items: center; }
      .question-row input { flex: 1; }
      video { width: 100%; max-width: 28rem; background: #111; border-radius: 8px; }
      .muted { color: var(--muted); }
    </style>
  </head>
  <body>
    <header>
      <strong>Hireflow<% if current_organization %> · <%= current_organization.name %><% end %></strong>
      <% if current_user %>
        <nav aria-label="Main">
          <% if current_user.staff? %>
            <%= link_to "Dashboard", org_dashboard_path %>
            <%= link_to "Templates", org_interview_templates_path %>
            <%= link_to "Invitations", org_invitations_path %>
            <%= link_to "Team", org_team_members_path if current_user.admin? %>
          <% else %>
            <%= link_to "My interviews", org_interviews_path %>
          <% end %>
          <span data-testid="current-user"><%= current_user.name %> (<%= current_user.role %>)</span>
          <%= button_to "Sign out", org_logout_path, method: :delete, class: "secondary", form: { style: "display:inline" } %>
        </nav>
      <% end %>
    </header>
    <main>
      <% if notice %><p role="status" class="flash"><%= notice %></p><% end %>
      <% if alert %><p role="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>

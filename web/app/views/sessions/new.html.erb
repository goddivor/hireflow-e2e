<% content_for :title, "Sign in" %>
<h1 class="t-h1 auth__title">Sign in to <%= current_organization.name %></h1>
<p class="auth__sub">Recruiters and admins sign in here. Candidates use the link from their invitation email.</p>

<%= form_with url: org_login_path, class: "auth__form" do |f| %>
  <%= render "layouts/flash" %>
  <div class="field">
    <label class="field__label" for="email">Email</label>
    <%= f.email_field :email, value: params[:email], required: true, autocomplete: "username", class: "input", placeholder: "you@company.com" %>
  </div>
  <div class="field">
    <label class="field__label" for="password">Password</label>
    <%= f.password_field :password, required: true, autocomplete: "current-password", class: "input", placeholder: "Your password" %>
  </div>
  <%= f.submit "Sign in", class: "btn btn--primary btn--lg btn--block" %>
<% end %>

<div class="auth__or"><span>or, without a password</span></div>

<%= form_with url: org_sign_in_link_path, class: "auth__form auth__form--tight" do |f| %>
  <div class="field">
    <label class="field__label" for="link_email">Email for a sign-in link</label>
    <%= f.email_field :email, id: "link_email", required: true, class: "input", placeholder: "you@company.com" %>
  </div>
  <%= f.submit "Email me a sign-in link", class: "btn btn--surface btn--lg btn--block" %>
<% end %>

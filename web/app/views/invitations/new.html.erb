<% content_for :title, "Invite a candidate" %>
<div class="page__head">
  <div>
    <h1 class="t-h1">Invite a candidate</h1>
    <p class="page__sub">They get an email with a single-use link, then confirm their phone with a texted code.</p>
  </div>
</div>
<section class="card">
  <% if @templates.empty? %>
    <p>Create an <%= link_to "interview template", new_org_interview_template_path, class: "link" %> first.</p>
  <% else %>
    <%= form_with model: @form, url: org_invitations_path, class: "form" do |f| %>
      <% if @form.errors.any? %><div role="alert" class="flash flash--alert"><%= @form.errors.full_messages.to_sentence %></div><% end %>
      <div class="field">
        <%= f.label :name, "Candidate name", class: "field__label" %>
        <%= f.text_field :name, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :email, "Candidate email", class: "field__label" %>
        <%= f.email_field :email, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :phone, "Candidate phone", class: "field__label" %>
        <%= f.telephone_field :phone, class: "input t-mono", placeholder: "+15551234567" %>
        <span class="field__hint">International format. The confirmation code goes here.</span>
      </div>
      <div class="field">
        <%= f.label :interview_template_id, "Interview template", class: "field__label" %>
        <%= f.collection_select :interview_template_id, @templates, :id, :title, { prompt: "Choose a template" }, class: "input" %>
      </div>
      <div><%= f.submit "Send invitation", class: "btn btn--primary" %></div>
    <% end %>
  <% end %>
</section>

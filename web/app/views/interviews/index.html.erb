<% content_for :title, "My interviews" %>
<div class="page__head">
  <div>
    <h1 class="t-h1">My interviews</h1>
    <p class="page__sub">Answer each question on camera, at your own pace.</p>
  </div>
</div>
<div class="card card--flush">
  <% if @invitations.any? %>
    <table class="table" aria-label="My interviews">
      <thead><tr><th scope="col">Interview</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
      <tbody>
        <% @invitations.each do |invitation| %>
          <tr>
            <td class="strong"><%= invitation.interview_template.title %></td>
            <td><%= status_badge(invitation.status) %></td>
            <td class="actions"><%= link_to "Open #{invitation.interview_template.title}", org_interview_path(id: invitation), class: "btn btn--primary btn--sm" unless invitation.status == "completed" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty"><span class="empty__art" aria-hidden="true"></span><p>You have no interviews yet.</p></div>
  <% end %>
</div>

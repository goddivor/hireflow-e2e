<section class="card">
  <%= form_with model: template, url: url, class: "form", id: "template-form" do |f| %>
    <% if template.errors.any? %><div role="alert" class="flash flash--alert"><%= template.errors.full_messages.to_sentence %></div><% end %>
    <div class="field">
      <%= f.label :title, "Title", class: "field__label" %>
      <%= f.text_field :title, class: "input", placeholder: "Senior Backend Engineer" %>
    </div>
    <fieldset class="fieldset">
      <legend>Questions</legend>
      <ol id="questions" class="questions">
        <% (template.questions.presence || [""]).each_with_index do |question, i| %>
          <li class="question-row">
            <input class="input" name="interview_template[questions][]" value="<%= question %>" aria-label="Question <%= i + 1 %>">
            <button type="button" class="btn btn--ghost btn--icon" data-action="up" aria-label="Move question <%= i + 1 %> up">↑</button>
            <button type="button" class="btn btn--danger-ghost btn--icon" data-action="remove" aria-label="Remove question <%= i + 1 %>"><span class="icon icon--sm icon--close" aria-hidden="true"></span></button>
          </li>
        <% end %>
      </ol>
      <div><button type="button" class="btn btn--surface btn--sm" id="add-question"><span class="icon icon--sm icon--plus" aria-hidden="true"></span>Add question</button></div>
    </fieldset>
    <div><%= f.submit submit_label, class: "btn btn--primary" %></div>
  <% end %>
</section>

<script>
  (() => {
    const list = document.getElementById("questions");

    // Labels follow the visible order, so screen readers and role-based locators stay truthful after a move.
    const relabel = () => [...list.children].forEach((row, i) => {
      row.querySelector("input").setAttribute("aria-label", `Question ${i + 1}`);
      row.querySelector("[data-action=up]").setAttribute("aria-label", `Move question ${i + 1} up`);
      row.querySelector("[data-action=remove]").setAttribute("aria-label", `Remove question ${i + 1}`);
    });

    document.getElementById("add-question").addEventListener("click", () => {
      const row = list.lastElementChild.cloneNode(true);
      row.querySelector("input").value = "";
      list.append(row);
      relabel();
      row.querySelector("input").focus();
    });

    list.addEventListener("click", (event) => {
      const button = event.target.closest("button[data-action]");
      if (!button) return;
      const row = button.closest("li");
      if (button.dataset.action === "up" && row.previousElementSibling) list.insertBefore(row, row.previousElementSibling);
      if (button.dataset.action === "remove") {
        if (list.children.length > 1) row.remove();
        else row.querySelector("input").value = "";
      }
      relabel();
    });
  })();
</script>

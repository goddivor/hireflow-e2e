{
  "name": "hireflow-e2e",
  "version": "1.0.0",
  "description": "Playwright E2E suite for a multi-tenant Rails hiring app: per-tenant, per-role saved sessions, email and SMS checks, camera flows, sharded CI.",
  "scripts": {
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "typecheck": "tsc",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
